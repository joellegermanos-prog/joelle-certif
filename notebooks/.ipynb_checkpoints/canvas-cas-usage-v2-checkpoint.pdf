   ],
   "source": [
    "# Croisements clés : catégorielles vs cible (tableaux croisés + test du Chi²) ---\n",
    "pd.set_option('display.max_rows', None)  # évite toute troncature de l'affichage (ex. region à 14 modalités)\n",
    "\n",
    "cat_vars = ['niveau_diplome', 'nationalite_hors_ue', 'est_allocataire' , 'synthese_entretien' , 'departement', 'region',\n",
    "            'code_rome_vise', 'code_rome_famille']\n",
    "\n",
    "n_vars = len(cat_vars)\n",
    "n_cols = 2\n",
    "n_rows = -(-n_vars // n_cols)  # arrondi supérieur → 4 lignes pour 8 variables\n",
    "\n",
    "fig, axes = plt.subplots(n_rows, n_cols, figsize=(16, 4 * n_rows))\n",
    "axes = axes.flatten()\n",
    "\n",
    "resultats_chi2 = {}  # pour réutilisation éventuelle (tableau de synthèse, rapport)\n",
    "\n",
    "for i, col in enumerate(cat_vars):\n",
    "    ct_full = pd.crosstab(df[col], df['classe_retour_emploi'], normalize='index')\n",
    "\n",
    "    # Test du Chi² sur la variable complète (jamais tronquée pour le calcul)\n",
    "    ct_raw = pd.crosstab(df[col], df['classe_retour_emploi'])\n",
    "    chi2, p, dof, expected = chi2_contingency(ct_raw)\n",
    "    resultats_chi2[col] = {\"chi2\": chi2, \"p\": p, \"ct\": ct_full}\n",
    "\n",
    "    print(f\"\\n--- {col} vs classe_retour_emploi (proportions par ligne) ---\")\n",
    "    print(ct_full.round(3).to_string())\n",
    "    print(f\"Chi² = {chi2:.2f}, p-value = {p:.4f}  (n modalités = {ct_full.shape[0]})\")\n",
    "\n",
    "    # --- Cas particulier : departement (96 modalités) → limiter au Top 20 par effectif ---\n",
    "    if col == \"departement\":\n",
    "        top_n = df[col].value_counts().head(20).index\n",
    "        ct = ct_full.loc[top_n]\n",
    "        titre_extra = \" (Top 20 par effectif)\"\n",
    "        rotation, ha = 90, \"center\"\n",
    "\n",
    "    # --- Cas particulier : code_rome_vise (50 modalités) → limiter au Top 15 pour l'affichage ---\n",
    "    elif col == \"code_rome_vise\":\n",
    "        top_n = df[col].value_counts().head(15).index\n",
    "        ct = ct_full.loc[top_n]\n",
    "        titre_extra = \" (Top 15 par effectif)\"\n",
    "        rotation, ha = 90, \"center\"\n",
    "\n",
    "    # --- Cas particulier : synthese_entretien (9 phrases longues) → labels raccourcis ---\n",
    "    elif col == \"synthese_entretien\":\n",
    "        ct = ct_full.copy()\n",
    "        ct.index = [label[:22] + \"…\" if len(label) > 22 else label for label in ct.index]\n",
    "        titre_extra = \"\"\n",
    "        rotation, ha = 30, \"right\"\n",
    "\n",
    "    else:\n",
    "        ct = ct_full\n",
    "        titre_extra = \"\"\n",
    "        rotation, ha = 45, \"right\"\n",
    "\n",
    "    ct.plot(kind='bar', stacked=True, colormap='viridis', ax=axes[i], legend=False)\n",
    "    axes[i].set_title(f'{col} vs classe_retour_emploi{titre_extra}\\n(Chi²={chi2:.1f}, p={p:.4f})',\n",
    "                       fontsize=11)\n",
    "    axes[i].set_ylabel('Proportion')\n",
    "    axes[i].set_xlabel(col)\n",
    "    axes[i].tick_params(axis='x', rotation=rotation)\n",
    "    for label in axes[i].get_xticklabels():\n",
    "        label.set_ha(ha)\n",
    "        label.set_fontsize(8)\n",
    "\n",
    "# Masque les sous-graphiques vides si besoin\n",
    "for j in range(n_vars, len(axes)):\n",
    "    axes[j].axis(\"off\")\n",
    "\n",
    "# Légende unique partagée\n",
    "handles, labels = axes[0].get_legend_handles_labels()\n",
    "fig.legend(handles, labels, title='classe_retour_emploi',\n",
    "           loc='upper center', bbox_to_anchor=(0.5, 1.01), ncol=3)\n",
    "\n",
    "plt.suptitle(\"Croisements variables catégorielles vs cible\", fontsize=15, fontweight=\"bold\", y=1.02)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "pd.reset_option('display.max_rows')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3192773f-6cc2-4ef2-9970-6670a2720774",
   "metadata": {},
   "source": [
    "📝 **Croisements variables catégorielles vs cible (§3.5)**\n",
    "\n",
    "- **`synthese_entretien`** (Chi²=1106,4) : signal le plus fort du dataset — catégorielle à 9 valeurs, pas du NLP.\n",
    "- **`niveau_diplome`** (Chi²=390,6) : gradient net, 7 % (Bac+5) à 41 % (Sans diplôme) de classe 2.\n",
    "- **`code_rome_vise`/`code_rome_famille`** (Chi²=334,7 / 133,5) : signal significatif, version famille retenue (plus stable).\n",
    "- **`nationalite_hors_ue`** (Chi²=123,7) : 15 % (UE) à 38 % (hors UE) — variable sensible, Scénario 2.\n",
    "- **`departement`/`region`** (Chi²=238,5, p=0,0097 / Chi²=21,9, p=0,69) : écart marqué au département, non significatif une fois agrégé en région → confirme l'artefact d'effectifs faibles, `region` retenue.\n",
    "- **`est_allocataire`** (Chi²=0,7, p=0,69) : Barres visuellement identiques, variable non discriminante..\n",
    "\n",
    "**À retenir** : Les paires brut/agrégé montrent qu'une haute cardinalité peut gonfler artificiellement le Chi²."
   ]
  },

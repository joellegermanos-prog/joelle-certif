  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "5520bea2-44f5-409d-9a88-79a6d3b6b2d2",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1800x600 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Cartes de répartition géographique : département + région\n",
    "\n",
    "# Préparation des variables géographiques ---\n",
    "\n",
    "# Comme code_insee_commune contient généralement les 5 chiffres INSEE\n",
    "df[\"departement\"] = df[\"code_insee_commune\"].astype(str).str[:2]\n",
    "\n",
    "# Correction DROM (codes à 3 chiffres tronqués par le str[:2])\n",
    "is_drom = df[\"code_insee_commune\"].astype(str).str.startswith(\"97\")\n",
    "\n",
    "region_map = {\n",
    "    '01':'ARA','03':'ARA','07':'ARA','15':'ARA','26':'ARA','38':'ARA','42':'ARA',\n",
    "    '43':'ARA','63':'ARA','69':'ARA','73':'ARA','74':'ARA',\n",
    "    '02':'HDF','59':'HDF','60':'HDF','62':'HDF','80':'HDF',\n",
    "    '08':'GES','10':'GES','51':'GES','52':'GES','54':'GES','55':'GES','57':'GES',\n",
    "    '67':'GES','68':'GES','88':'GES',\n",
    "    '14':'NOR','27':'NOR','50':'NOR','61':'NOR','76':'NOR',\n",
    "    '18':'CVL','28':'CVL','36':'CVL','37':'CVL','41':'CVL','45':'CVL',\n",
    "    '19':'NAQ','23':'NAQ','24':'NAQ','33':'NAQ','40':'NAQ','47':'NAQ','64':'NAQ',\n",
    "    '79':'NAQ','86':'NAQ','87':'NAQ','16':'NAQ','17':'NAQ',\n",
    "    '09':'OCC','11':'OCC','12':'OCC','30':'OCC','31':'OCC','32':'OCC','34':'OCC',\n",
    "    '46':'OCC','48':'OCC','65':'OCC','66':'OCC','81':'OCC','82':'OCC',\n",
    "    '13':'PAC','04':'PAC','05':'PAC','06':'PAC','83':'PAC','84':'PAC',\n",
    "    '21':'BFC','25':'BFC','39':'BFC','58':'BFC','70':'BFC','71':'BFC','89':'BFC','90':'BFC',\n",
    "    '22':'BRE','29':'BRE','35':'BRE','56':'BRE',\n",
    "    '44':'PDL','49':'PDL','53':'PDL','72':'PDL','85':'PDL',\n",
    "    '75':'IDF','77':'IDF','78':'IDF','91':'IDF','92':'IDF','93':'IDF','94':'IDF','95':'IDF',\n",
    "    '2A':'COR','2B':'COR',\n",
    "}\n",
    "df[\"region\"] = df[\"departement\"].map(region_map)\n",
    "df.loc[is_drom, \"region\"] = \"DROM\"\n",
    "\n",
    "# Effectifs par département et par région ---\n",
    "\n",
    "dep_counts = df[\"departement\"].value_counts().reset_index()\n",
    "dep_counts.columns = [\"code\", \"effectif\"]\n",
    "\n",
    "reg_counts = df[\"region\"].value_counts().reset_index()\n",
    "reg_counts.columns = [\"region\", \"effectif\"]\n",
    "# Chargement du fond de carte départemental\n",
    "\n",
    "# !pip install geopandas\n",
    "france = gpd.read_file(\"../data/departements.geojson\")\n",
    "\n",
    "# Carte 1 : répartition par département (comme avant) ---\n",
    "\n",
    "carte_dep = france.merge(dep_counts, left_on=\"code\", right_on=\"code\", how=\"left\")\n",
    "carte_dep[\"effectif\"] = carte_dep[\"effectif\"].fillna(0)\n",
    "\n",
    "# Construction du fond de carte régional (dissolve département -> région) ---\n",
    "\n",
    "france_reg = france.copy()\n",
    "france_reg[\"region\"] = france_reg[\"code\"].map(region_map)\n",
    "# Les DROM du geojson (971, 972, 973, 974, 976...) ne seront pas dans region_map\n",
    "# (car region_map est indexé sur les codes métropolitains à 2 caractères) :\n",
    "france_reg.loc[france_reg[\"code\"].astype(str).str.startswith(\"97\"), \"region\"] = \"DROM\"\n",
    "\n",
    "# Fusion des polygones de département en un seul polygone par région\n",
    "france_reg = france_reg.dissolve(by=\"region\", as_index=False)\n",
    "\n",
    "carte_reg = france_reg.merge(reg_counts, on=\"region\", how=\"left\")\n",
    "carte_reg[\"effectif\"] = carte_reg[\"effectif\"].fillna(0)\n",
    "\n",
    "# Affichage : département vs région ---\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(18, 6))\n",
    "\n",
    "carte_dep.plot(column=\"effectif\", cmap=\"Blues\", legend=True, ax=axes[0],\n",
    "               edgecolor=\"grey\", linewidth=0.3)\n",
    "axes[0].set_title(\"Répartition géographique des bénéficiaires\\npar département (96 modalités)\")\n",
    "axes[0].axis(\"off\")\n",
    "\n",
    "carte_reg.plot(column=\"effectif\", cmap=\"Blues\", legend=True, ax=axes[1],\n",
    "               edgecolor=\"black\", linewidth=0.6)\n",
    "axes[1].set_title(\"Répartition géographique des bénéficiaires\\npar région (14 modalités)\")\n",
    "axes[1].axis(\"off\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },

   ],
   "source": [
    "# 2. Fonction de calcul du Disparate Impact (règle des 4/5) ---\n",
    "\n",
    "def compute_disparate_impact(df, sensitive_col, target_col, positive_value,\n",
    "                              min_group_size=None):\n",
    "    \"\"\"\n",
    "    Calcule le Disparate Impact Ratio (règle des 4/5) pour une variable sensible.\n",
    "\n",
    "    DI = taux d'issue favorable du groupe le moins favorisé\n",
    "         / taux d'issue favorable du groupe le plus favorisé\n",
    "\n",
    "    min_group_size : exclut les groupes trop petits (effectifs peu fiables)\n",
    "    \"\"\"\n",
    "    grp = df.groupby(sensitive_col, observed=True)[target_col]\n",
    "    sizes = grp.size()\n",
    "    selection_rate = grp.apply(lambda x: (x == positive_value).mean())\n",
    "\n",
    "    if min_group_size is not None:\n",
    "        keep = sizes[sizes >= min_group_size].index\n",
    "        selection_rate = selection_rate.loc[keep]\n",
    "\n",
    "    sr_min, sr_max = selection_rate.min(), selection_rate.max()\n",
    "    di = sr_min / sr_max\n",
    "\n",
    "    if di < 0.8:\n",
    "        verdict = \"⚠️ Signal\"\n",
    "    elif di > 1.25:\n",
    "        verdict = \"⚠️ Signal inversé\"\n",
    "    else:\n",
    "        verdict = \"✅ OK\"\n",
    "\n",
    "    return {\n",
    "        \"Variable\": sensitive_col,\n",
    "        \"N groupes\": len(selection_rate),\n",
    "        \"Selection Rate min\": round(sr_min, 3),\n",
    "        \"Selection Rate max\": round(sr_max, 3),\n",
    "        \"DI\": round(di, 3),\n",
    "        \"Verdict\": verdict\n",
    "    }\n",
    "\n",
    "# Calcul du DI pour chaque variable sensible + groupes de contrôle ---\n",
    "\n",
    "sensitive_vars = [\n",
    "    \"nationalite_hors_ue\",\n",
    "    \"groupe_age\",\n",
    "    \"region\",           # remplace departement pour l'analyse d'équité\n",
    "]\n",
    "\n",
    "control_vars = [\n",
    "    \"est_allocataire\",  # groupe de contrôle : pas de discrimination attendue\n",
    "    \"niveau_diplome\",   # légitimement corrélé, pas un critère protégé\n",
    "]\n",
    "\n",
    "results = []\n",
    "for var in sensitive_vars + control_vars:\n",
    "    results.append(\n",
    "        compute_disparate_impact(\n",
    "            df=df,\n",
    "            sensitive_col=var,\n",
    "            target_col=\"classe_retour_emploi\",\n",
    "            positive_value=0  # classe 0 = retour rapide, considérée \"issue favorable\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "# Ajout du département brut à titre de comparaison (pour illustrer l'artefact)\n",
    "results.append(\n",
    "    compute_disparate_impact(df, \"departement\", \"classe_retour_emploi\", 0)\n",
    ")\n",
    "results.append(\n",
    "    compute_disparate_impact(df, \"departement\", \"classe_retour_emploi\", 0, min_group_size=15)\n",
    ")\n",
    "\n",
    "di_table = pd.DataFrame(results).sort_values(by=\"DI\").reset_index(drop=True)\n",
    "di_table"
   ]
  },

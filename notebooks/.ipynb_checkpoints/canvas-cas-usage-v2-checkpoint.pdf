   "id": "a61900f3-b1ab-40e5-a89e-7c10a1bf628c",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1800x800 with 4 Axes>"

   "source": [
    "# 3.2 Qualité des données : manquants, doublons, valeurs aberrantes\n",
    "\n",
    "# Valeurs manquantes\n",
    "df_missing = pd.DataFrame({\n",
    "    'Valeurs manquantes': df.isna().sum(),\n",
    "    'Pourcentage (%)': (df.isna().mean() * 100).round(2)\n",
    "})\n",
    "\n",
    "# Tri par ordre décroissant selon le nombre de valeurs manquantes\n",
    "df_missing = df_missing.sort_values(by='Valeurs manquantes', ascending=False)\n",
    "\n",
    "# ajouter le symbole \"%\" en fin de chaîne pour l'affichage\n",
    "df_missing['Pourcentage (%)'] = df_missing['Pourcentage (%)'].astype(str) + \" %\"\n",
    "\n",
    "print(\"Valeurs manquantes par colonne :\")\n",
    "display(df_missing)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "a32c90b6-5b07-43e3-a7ca-29f139b8bdd3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Nombre de lignes dupliquées (toutes colonnes) : 0\n",
      "Nombre d'identifiants usager dupliqués : 0\n"
     ]
    }
   ],
   "source": [
    "# Doublons\n",
